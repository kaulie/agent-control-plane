# Cursor API key used by the SDK (local agent). Create one in the Cursor
# dashboard (Settings -> API Keys) and paste it here. This file is gitignored.
CURSOR_API_KEY=

# Port the Agent Gateway listens on.
# Resolution order: SERVICE_PORT → PORT → 4211 (default).
# Runtime (production) uses 4211. Local/dev gateway must use another port (e.g. 4212).
# SERVICE_PORT=4211
PORT=4211

# Root for per-task agent sandboxes. Each new task gets
#   <AGENT_WORKSPACE_ROOT>/<taskId>/
# Default: /Users/gaolei/agent-workspace
# Legacy AGENT_WORKSPACE is still read as the root if ROOT is unset.
# Values pointing at the old shared dev-repo path are redirected to the default root.
AGENT_WORKSPACE_ROOT=/Users/gaolei/agent-workspace

# Optional: pin a model id (e.g. "claude-sonnet-5"). Leave empty to auto-discover.
CURSOR_MODEL=

# ---- Agent providers ----------------------------------------------------------
# Global default when a task/project does not pin a provider: "cursor" | "cline".
# Both adapters are loaded at startup; per-task selection can override this.
AGENT_PROVIDER=cursor

# Global cap on concurrently running agent runs across all tasks/providers.
AGENT_MAX_CONCURRENT_RUNS=2

# Gateway RSS limit in MiB. When exceeded and a run is active, the oldest active
# run is cancelled to shed memory pressure. Set to 0 to disable auto-shedding.
AGENT_RSS_LIMIT_MB=2048

# Cline/LLM provider id (default "deepseek").
CLINE_PROVIDER_ID=deepseek

# DeepSeek API key used by the Cline adapter.
DEEPSEEK_API_KEY=

# Optional: pin a Cline model id (e.g. "deepseek-v4-pro"). Leave empty to auto-discover.
CLINE_MODEL=

# Optional: base URL override (only for OpenAI-compatible providers).
#CLINE_BASE_URL=

# Optional: system prompt override for Cline sessions.
#CLINE_SYSTEM_PROMPT=

# ---- Git / network proxy (local HTTP proxy, e.g. Clash) ------------------------
# Proxy URL. Unset → default http://127.0.0.1:7897. Set to empty to disable all.
# GIT_VIA_PROXY_URL=http://127.0.0.1:7897
#
# Inject HTTP(S)_PROXY into the gateway process so Shell / gh inherit it (1/0).
# GIT_VIA_PROXY_SHELL=1
#
# Inject git-via-proxy MCP into Cursor agents for one-shot proxied git/gh (1/0).
# GIT_VIA_PROXY_MCP=1
GIT_VIA_PROXY_URL=http://127.0.0.1:7897
GIT_VIA_PROXY_SHELL=1
GIT_VIA_PROXY_MCP=1
