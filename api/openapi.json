    "/api/auth": {
      "get": {
        "summary": "账号池 + 各 provider 的鉴权状态",
        "operationId": "getApiAuth",
        "tags": [
          "catalog"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
